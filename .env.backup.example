# Nusxa oling: cp .env.backup.example .env.backup && chmod 600 .env.backup
# Zaxira nusxalar serverdan TASHQARIGA rclone orqali yuboriladi (S3 / Cloudflare R2 / Backblaze / SFTP ...).
# Avval `rclone config` bilan remote yarating. Maslahat: faqat YOZISH huquqli kalit va `crypt` remote.
BACKUP_DIR=/var/backups/harakat
BACKUP_RCLONE_REMOTE=r2:harakat-backups
