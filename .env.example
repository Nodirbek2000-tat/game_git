# Nusxa oling: cp .env.example .env && chmod 600 .env   (.env gitga tushmaydi)
# Qiymatlarni serverda to'ldiring. Kalit/parol generatsiyasi:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"   -> DJANGO_SECRET_KEY
#   openssl rand -hex 24                                            -> POSTGRES_PASSWORD
# POSTGRES_PASSWORD faqat harf/raqamdan iborat bo'lsin (hex) — DATABASE_URL ichida maxsus belgi buzadi.

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=moveandplay.uz,www.moveandplay.uz
CSRF_TRUSTED_ORIGINS=https://moveandplay.uz,https://www.moveandplay.uz
# Hozircha ishlatilmaydi (kelajak uchun):
CORS_ALLOWED_ORIGINS=https://moveandplay.uz
# HSTS: dastlab 3600; HTTPS to'liq ishlashiga ishonch hosil qilgach 31536000 ga oshiring
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_HSTS_PRELOAD=false
# Gunicorn worker soni (taxminan CPU soni * 2 + 1)
WEB_CONCURRENCY=3

# --- PostgreSQL (compose db uchun shu fayldan o'qiydi; django DATABASE_URL ni ishlatadi) ---
POSTGRES_DB=harakat
POSTGRES_USER=harakat
POSTGRES_PASSWORD=
DATABASE_URL=postgres://harakat:PAROL_SHU_YERGA@db:5432/harakat

# --- Redis (ichki tarmoq, tashqariga ochilmaydi) ---
REDIS_URL=redis://redis:6379/0

# --- Telegram statistika boti (bot konteyneri) ---
# @BotFather bergan token (maxfiy! gitga tushmaydi)
TELEGRAM_BOT_TOKEN=
# Statistikani ko'ra oladiganlar: Telegram ID lar vergul bilan. ID ni bilish: botga /start yozing, o'zi aytadi.
TELEGRAM_ADMIN_IDS=
